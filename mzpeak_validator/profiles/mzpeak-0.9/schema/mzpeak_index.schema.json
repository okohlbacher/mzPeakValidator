{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mzpeak_index",
  "type": "object",
  "required": [
    "files",
    "metadata"
  ],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "entity_type",
          "data_kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "entity_type": {
            "type": "string",
            "$comment": "Controlled values use UNDERSCORES (wavelength_spectrum), matching schema/mzpeak_index.json in the specification and the reference implementation. Deliberately not a closed enum: an unrecognized value is treated as `other`.",
            "examples": [
              "spectrum",
              "chromatogram",
              "wavelength_spectrum",
              "other",
              "proprietary"
            ]
          },
          "data_kind": {
            "type": "string",
            "$comment": "Controlled values use UNDERSCORES (data_arrays, selected_ions). Deliberately not a closed enum: an unrecognized value is treated as `other`.",
            "examples": [
              "metadata",
              "data_arrays",
              "peaks",
              "scans",
              "precursors",
              "selected_ions",
              "products",
              "other",
              "proprietary"
            ]
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
